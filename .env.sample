# Copy to .env before running the project locally.
# The project loads settings from environment variables prefixed with PIFW_ and standard provider API keys.

# ==============================================================================
# 🛡️ 1. Firewall Core & Layer Configuration
# ==============================================================================
PIFW_ENABLED_LAYERS=L1,L2,L3,structural,session,egress,canary,tool_guard
PIFW_ALLOW_USER_INPUT=true
PIFW_LOG_CONTENT=false
PIFW_FAIL_MODE=warn
PIFW_SESSION_ID=default

# Thresholds
PIFW_THRESHOLD_ALLOW=0.30
PIFW_THRESHOLD_SANITIZE=0.55
PIFW_THRESHOLD_QUARANTINE=0.75
PIFW_THRESHOLD_BLOCK=0.85

# Risk Boost Multipliers
PIFW_UNTRUSTED_BOOST=0.15
PIFW_HIDDEN_BOOST=0.20
PIFW_OBFUSCATION_BOOST=0.25
PIFW_MAX_FINDINGS=8

# L2 ML Classifier Model (Default: Meta's Prompt Guard 86M)
# Options: meta-llama/Prompt-Guard-86M | protectai/deberta-v3-base-prompt-injection-v2
PIFW_CLASSIFIER_MODEL=meta-llama/Prompt-Guard-86M


# ==============================================================================
# ⚖️ 2. Layer 3 (L3) LLM Judge Configuration
# ==============================================================================
# Provider Options: gemini | openai | azure | anthropic | generic
# (Leave empty to auto-detect based on API keys provided below)
PIFW_JUDGE_PROVIDER=gemini

# Model Options:
# For Gemini:    gemini-1.5-flash (recommended) | gemini-2.0-flash
# For OpenAI:    gpt-4o-mini (recommended) | gpt-4o
# For Anthropic: claude-3-haiku-20240307
PIFW_JUDGE_MODEL=gemini-1.5-flash

# ==============================================================================
# 🔑 3. Provider API Keys (Provide the one corresponding to your provider)
# ==============================================================================

# Google Gemini API Key
GEMINI_API_KEY=AIzaSyBWTfH0gTEp9lChwLKslvz5M9OaA-3YanE
# GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI API Key & Endpoint
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# ==============================================================================
# ⚙️ 4. Runtime Configuration
# ==============================================================================
PYTHONPATH=src
APP_ENV=development
